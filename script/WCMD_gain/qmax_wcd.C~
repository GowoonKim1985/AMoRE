double dgaus(double *v, double *p){
  double x = v[0];

  double a = p[0];
  double b = p[1];
  double c = p[2];
  double d = p[3];
  double e = p[4];
  double f = p[5];

  return a*TMath::Gaus(x, b, c)+d*TMath::Gaus(x, e, f);
}

